name: Atualizar Painel de Projetos

on:
  schedule:
    # 07h e 13h de Brasília (10h e 16h UTC), de segunda a sexta — mesma programação do Cowork
    - cron: '0 10,16 * * 1-5'
  workflow_dispatch:   # permite rodar manualmente pelo botão "Run workflow"

permissions:
  contents: write

jobs:
  atualizar:
    runs-on: ubuntu-latest
    steps:
      - name: Baixar o repositório
        uses: actions/checkout@v4

      - name: Preparar Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.12'

      - name: Gerar o painel a partir do Notion
        env:
          NOTION_TOKEN: ${{ secrets.NOTION_TOKEN }}
        run: python generate.py

      - name: Publicar se houver mudanças
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add index.html
          if git diff --staged --quiet; then
            echo "Sem alterações nos dados — nada a publicar."
          else
            git commit -m "Atualização automática do painel ($(TZ=America/Sao_Paulo date '+%d/%m/%Y %H:%M'))"
            git push
          fi
